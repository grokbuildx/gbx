ObjC.import('AppKit');
ObjC.import('Foundation');

function run(argv) {
  const executable = argv[0];
  const provider = argv[1];
  const app = $.NSApplication.sharedApplication;
  app.setActivationPolicy($.NSApplicationActivationPolicyAccessory);

  function launch(args) {
    const task = $.NSTask.alloc.init;
    task.launchPath = $(executable);
    task.arguments = $(args);
    task.standardOutput = $.NSFileHandle.fileHandleWithNullDevice;
    task.standardError = $.NSFileHandle.fileHandleWithNullDevice;
    task.launch;
  }

  function readConfigurations() {
    const task = $.NSTask.alloc.init;
    const pipe = $.NSPipe.pipe;
    task.launchPath = $(executable);
    task.arguments = $(['codex', 'menu-configs']);
    task.standardOutput = pipe;
    task.standardError = $.NSFileHandle.fileHandleWithNullDevice;
    task.launch;
    const data = pipe.fileHandleForReading.readDataToEndOfFile;
    task.waitUntilExit;
    if (task.terminationStatus !== 0) return {current: provider, providers: []};
    return JSON.parse(ObjC.unwrap($.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding)));
  }

  ObjC.registerSubclass({
    name: 'GBXProxyMenuAction',
    superclass: 'NSObject',
    methods: {
      'stopProxy:': {
        types: ['void', ['id']],
        implementation: function () {
          launch(['codex', 'stop']);
        }
      },
      'restartApp:': {
        types: ['void', ['id']],
        implementation: function () {
          launch(['codex', 'menu-restart']);
        }
      },
      'switchProvider:': {
        types: ['void', ['id']],
        implementation: function (sender) {
          launch(['codex', 'menu-switch', '--provider', ObjC.unwrap(sender.representedObject)]);
        }
      },
      'appTerminated:': {
        types: ['void', ['id']],
        implementation: function (notification) {
          try {
            const info = notification && notification.userInfo;
            if (!info) return;
            const terminated = info.objectForKey($.NSWorkspaceApplicationKey);
            if (!terminated) return;
            const bid = ObjC.unwrap(terminated.bundleIdentifier) || '';
            const burl = (terminated.bundleURL ? ObjC.unwrap(terminated.bundleURL.path) : '') || '';
            const config = readConfigurations();
            const watched = config && config.watched_app;
            if (!watched) return;
            if ((watched.bundle_id && bid === watched.bundle_id) || (watched.path && burl === watched.path)) {
              launch(['codex', 'menu-app-exited']);
            }
          } catch (_) {}
        }
      },
      'menuNeedsUpdate:': {
        types: ['void', ['id']],
        implementation: function () {
          refreshMenu();
        }
      }
    }
  });

  const action = $.GBXProxyMenuAction.alloc.init;
  const item = $.NSStatusBar.systemStatusBar.statusItemWithLength($.NSVariableStatusItemLength);
  const image = $.NSImage.imageWithSystemSymbolNameAccessibilityDescription('arrow.triangle.branch', 'GBX Codex');
  if (image) {
    image.template = true;
    item.button.image = image;
  } else {
    item.button.title = $('GBX');
  }
  item.button.toolTip = $('GBX Codex: ' + provider);
  const menu = $.NSMenu.alloc.initWithTitle('GBX Codex');
  menu.autoenablesItems = false;
  menu.delegate = action;

  function refreshMenu() {
    let config;
    try { config = readConfigurations(); }
    catch (_) { config = {current: provider, providers: []}; }
    menu.removeAllItems;
    const heading = $.NSMenuItem.alloc.init;
    heading.title = $('GBX Codex: ' + config.current);
    heading.enabled = false;
    menu.addItem(heading);
    menu.addItem($.NSMenuItem.separatorItem);
    for (const name of config.providers) {
      const choice = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent(name, 'switchProvider:', '');
      choice.representedObject = $(name);
      choice.target = action;
      choice.state = name === config.current ? $.NSControlStateValueOn : $.NSControlStateValueOff;
      menu.addItem(choice);
    }
    menu.addItem($.NSMenuItem.separatorItem);
    const target = config.watched_app || config.desktop_app;
    if (target && target.name) {
      const restart = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent('Restart ' + target.name, 'restartApp:', '');
      restart.target = action;
      menu.addItem(restart);
    }
    const stop = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent('Disconnect Codex', 'stopProxy:', '');
    stop.target = action;
    menu.addItem(stop);
  }

  refreshMenu();
  item.menu = menu;
  $.NSWorkspace.sharedWorkspace.notificationCenter.addObserverSelectorNameObject(
    action, 'appTerminated:', $.NSWorkspaceDidTerminateApplicationNotification, null
  );
  app.run;
}
